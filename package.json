{
  "name": "anchor-benefit-continuity",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first, source-linked benefit notice and action workspace.",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/build-cloudflare.mjs",
    "deploy": "node scripts/deploy-cloudflare.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "dev:static": "node server.mjs",
    "vendor": "node scripts/vendor.mjs",
    "samples": "node scripts/sample-notices.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check server/worker.js && node --check server/anchor-api.js && node --check web/app.js && node --check web/account.js"
  },
  "dependencies": {
    "jose": "6.1.0",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.0.0",
    "pdf-lib": "1.17.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.92.0"
  }
}
