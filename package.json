{
  "name": "anchor-benefit-continuity",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first, source-linked benefit notice and action workspace.",
  "scripts": {
    "dev": "npm run build && node server.mjs",
    "build": "node --env-file-if-exists=.env.local scripts/build-pages.mjs",
    "typecheck": "tsc --noEmit",
    "check": "node --check web/app.js && node --check web/account.js && node --check web/platform.js && node --check web/sw.js",
    "test": "node --test tests/*.test.mjs",
    "test:audit": "python -m unittest discover -s tests -p test_*.py",
    "audit": "python scripts/audit_sources.py --site dist/pages",
    "dev:static": "node server.mjs",
    "vendor": "node scripts/vendor.mjs",
    "samples": "node scripts/sample-notices.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"web/*.js\" \"web/*.css\" \"scripts/*.mjs\" \"server.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"web/*.js\" \"web/*.css\" \"scripts/*.mjs\" \"server.mjs\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "tesseract.js": "6.0.1",
    "tesseract.js-core": "6.0.0"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "playwright": "1.64.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3"
  }
}
